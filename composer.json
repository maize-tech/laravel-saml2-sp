{
    "name": "maize-tech/laravel-saml2-sp",
    "description": "Laravel Saml2 Service Provider",
    "keywords": [
        "maize-tech",
        "laravel",
        "saml2",
        "service",
        "provider"
    ],
    "homepage": "https://github.com/maize-tech/laravel-saml2-sp",
    "license": "MIT",
    "authors": [
        {
            "name": "Riccardo Dalla Via",
            "email": "riccardo.dallavia@maize.io",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^10.0|^11.0",
        "illuminate/database": "^10.0|^11.0",
        "illuminate/http": "^10.0|^11.0",
        "illuminate/routing": "^10.0|^11.0",
        "illuminate/support": "^10.0|^11.0",
        "onelogin/php-saml": "^4.1",
        "spatie/laravel-package-tools": "^1.14.1",
        "spatie/url": "^2.2"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^6.0|^7.8|^8.1",
        "larastan/larastan": "^2.0.1",
        "orchestra/testbench": "^8.0|^9.0",
        "pestphp/pest": "^2.34",
        "pestphp/pest-plugin-arch": "^2.7",
        "pestphp/pest-plugin-laravel": "^2.3",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^1.0",
        "phpstan/phpstan-phpunit": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Maize\\Saml2Sp\\": "src",
            "Maize\\Saml2Sp\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Maize\\Saml2Sp\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "APP_KEY='base64:WZWVY1adHg5rodWQighydXaigzW8saEGq43rFgfWsRt=' vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Maize\\Saml2Sp\\Saml2SpServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
